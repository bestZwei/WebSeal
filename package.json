{
  "name": "webseal",
  "version": "1.0.0",
  "description": "专业的网页存证工具 - 使用盲水印技术为网页快照添加时间戳和自定义文字水印",
  "private": true,
  "keywords": [
    "web",
    "screenshot",
    "watermark",
    "evidence",
    "archive",
    "steganography"
  ],
  "author": "WebSeal Team",
  "license": "Anti-Capitalist Software License 1.4",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx scripts/test-watermark.mjs && tsx scripts/test-url-guard.mjs && tsx scripts/test-tsa.mjs",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t webseal:latest .",
    "docker:run": "docker run -d --shm-size=256m -p 3000:3000 --name webseal-container webseal:latest",
    "docker:stop": "docker stop webseal-container && docker rm webseal-container",
    "docker:logs": "docker logs -f webseal-container",
    "docker:pull": "docker pull ghcr.io/bestzwei/webseal:latest",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:pull": "docker compose pull",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "release:push": "git push --follow-tags"
  },
  "dependencies": {
    "@peculiar/asn1-tsp": "^2.9.4",
    "lucide-react": "^0.514.0",
    "next": "15.3.3",
    "puppeteer": "^24.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
