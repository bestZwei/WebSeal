# WebSeal 运行环境配置示例
# 使用方法：cp .env.example .env，然后取消 docker-compose.yml 中 env_file 部分的注释
# 注意：本文件仅作为模板，真实的私钥请只保存在服务器上，不要提交到代码库

# ---------- 镜像版本 ----------
# 锁定版本可避免 latest 意外升级；留空则用 docker-compose.yml 中的默认值
# 可选值：1.0.0（精确版本）/ 1.0（小版本线）/ latest
WEBSEAL_IMAGE=ghcr.io/bestzwei/webseal:latest

# ---------- 服务运行 ----------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ---------- Puppeteer / Chromium ----------
# 镜像内已通过 apk 安装系统 Chromium，无需下载 Puppeteer 自带 Chrome
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ---------- 水印签名（可选，生产建议开启） ----------
# 生成方式：node scripts/generate-keys.mjs
# 多行 PEM 在 .env 中请用 \n 连接成一行，例如：
# WEBSEAL_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAw...\n-----END PRIVATE KEY-----
# 仅配置私钥即可，公钥会自动从私钥推导
WEBSEAL_PRIVATE_KEY=
WEBSEAL_PUBLIC_KEY=

# ---------- 可信时间戳（可选） ----------
# RFC 3161 时间戳服务，配置后对快照哈希请求权威时间背书
WEBSEAL_TSA_URL=
# 设为 true 时 TSA 请求失败会导致截图失败；默认留空即 best-effort 降级
WEBSEAL_TSA_REQUIRED=false

# ---------- 站点地址（可选） ----------
# 影响页面 SEO metadata 中的 canonical / og:url，例如 https://webseal.example.com
NEXT_PUBLIC_BASE_URL=
